# Better Auth (anonymous stranger auth)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-32-chars-minimum
BETTER_AUTH_URL=https://zeroplayer.space
# Short login token lifetime in days (default: 30)
AGENT_TOKEN_TTL_DAYS=30
# Local SQLite database file (optional; defaults to file:.data/db/sqlite.db)
DATABASE_URL=file:.data/db/sqlite.db
# Production startup migrations folder (optional; defaults to the bundled
# .output/server/db/migrations/sqlite)
MIGRATIONS_DIR=
