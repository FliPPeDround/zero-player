    "@modelcontextprotocol/server": "catalog:mcp",
    "agents": "catalog:mcp",
    "better-auth": "catalog:auth",
    "colorjs.io": "catalog:design",
    "drizzle-orm": "catalog:db",
    "floating-vue": "catalog:design",
    "leafer-ui": "catalog:canvas",
    "reka-ui": "catalog:design",
    "sugar-high": "catalog:frontend"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@better-auth/cli": "catalog:auth",
    "@iconify-json/carbon": "catalog:icons",
    "@iconify-json/ph": "catalog:icons",
    "@iconify-json/twemoji": "catalog:icons",
    "@nuxt/devtools": "catalog:build",
    "@nuxt/eslint": "catalog:build",
    "@nuxthub/core": "catalog:server",
