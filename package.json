    "archiver": "catalog:build",
    "bumpp": "catalog:cli",
    "drizzle-kit": "catalog:db",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "h3": "catalog:server",
    "nuxt": "catalog:build",
    "skills-npm": "catalog:skills",
    "typescript": "catalog:dev",
    "unocss": "catalog:build",
    "vitest": "catalog:dev",
    "vue": "catalog:frontend",
