{
  "type": "module",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "auth:schema": "better-auth generate --config scripts/auth-schema.config.ts --output server/db/schema/auth.ts -y && eslint server/db/schema/auth.ts --fix",
    "dev:pwa": "VITE_PLUGIN_PWA=true nuxt dev",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "prepare": "nuxt prepare && (skills-npm || true)",
    "pregenerate": "pnpm skills:zip",
    "release": "bumpp",
    "preview": "nuxt preview",
    "rooms:create": "node scripts/create-rooms.mjs",
    "prebuild": "pnpm skills:zip",
    "predev": "pnpm skills:zip",
    "skills:zip": "node scripts/build-skill-zip.mjs",
    "start": "node .output/server/index.mjs",
    "start:generate": "npx serve .output/public",
    "test": "vitest run",
    "test:24-point": "vitest run tests/games/24-point.test.ts",
    "test:gomoku": "vitest run tests/games/gomoku.test.ts",
    "test:liar-dice": "vitest run tests/games/liar-dice.test.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 nuxt build"
  },
  "dependencies": {
    "@antfu/design": "catalog:design",
