{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "auth:schema": "better-auth generate --config scripts/auth-schema.config.ts --output server/db/schema/auth.ts -y && eslint server/db/schema/auth.ts --fix",
    "dev:pwa": "VITE_PLUGIN_PWA=true nuxt dev",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "prepare": "nuxt prepare && skills-npm",
    "preview": "nuxt preview",
    "rooms:create": "node scripts/create-rooms.mjs",
    "start": "node .output/server/index.mjs",
    "start:generate": "npx serve .output/public",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "build": "bash -lc 'if [[ -z \"${WORKERS_CI_BRANCH:-}\" || \"$WORKERS_CI_BRANCH\" == \"main\" ]]; then pnpm run build:production; else pnpm run build:preview; fi'",
    "build:production": "NODE_OPTIONS=--max-old-space-size=4096 nuxt build",
    "build:preview": "NODE_OPTIONS=--max-old-space-size=4096 nuxt build --envName preview",
    "deploy:cloudflare": "sh -c 'pnpm exec wrangler --cwd .output/server d1 migrations apply DB --remote && pnpm exec wrangler --cwd .output deploy --keep-vars'",
    "deploy:cloudflare:preview": "sh -c 'pnpm exec wrangler --cwd .output/server d1 migrations apply DB --remote && pnpm exec wrangler --cwd .output versions upload'"
  },
  "dependencies": {
    "@antfu/design": "catalog:design",
    "@leafer-in/animate": "catalog:canvas",
    "@leafer-in/color": "catalog:canvas",
    "@libsql/client": "catalog:",
    "better-auth": "catalog:auth",
    "colorjs.io": "catalog:design",
    "drizzle-orm": "catalog:",
    "floating-vue": "catalog:design",
    "leafer-ui": "catalog:canvas",
    "reka-ui": "catalog:design"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@better-auth/cli": "catalog:auth",
    "@iconify-json/carbon": "catalog:icons",
    "@iconify-json/ph": "catalog:icons",
    "@iconify-json/twemoji": "catalog:icons",
    "@nuxt/devtools": "catalog:build",
    "@nuxt/eslint": "catalog:build",
    "@nuxthub/core": "catalog:server",
    "@nuxtjs/color-mode": "catalog:build",
    "@nuxtjs/mcp-toolkit": "catalog:agents",
    "@pinia/nuxt": "catalog:build",
    "@types/node": "catalog:dev",
    "@unocss/eslint-config": "catalog:build",
    "@unocss/nuxt": "catalog:build",
    "@vite-pwa/nuxt": "catalog:build",
    "@vueuse/core": "catalog:frontend",
    "@vueuse/nuxt": "catalog:build",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "h3": "catalog:server",
    "nuxt": "catalog:build",
    "pinia": "catalog:frontend",
    "skills-npm": "catalog:skills",
    "typescript": "catalog:dev",
    "unocss": "catalog:build",
    "vue": "catalog:frontend",
    "vue-tsc": "catalog:dev",
    "wrangler": "catalog:server",
    "zod": "catalog:validate"
  },
  "resolutions": {
    "@nuxt/devtools": "catalog:build",
    "@nuxt/kit": "catalog:build",
    "chokidar": "catalog:build",
    "nuxt": "catalog:build",
    "semver": "catalog:build",
    "unplugin": "catalog:build",
    "vite": "catalog:build"
  }
}
